    "hDH-Oh-16i.text" : {
      "comment" : "Class = \"UILabel\"; text = \"\\\"All entry subject to doorman discretion\\\". Patrons must adhere to venue dress code & policies. Cover tickets expire in 2 hours after time of purchase.\"; ObjectID = \"hDH-Oh-16i\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"All entry subject to doorman discretion\". Patrons must adhere to venue dress code & policies. Cover tickets expire in 2 hours after time of purchase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Toda entrada está sujeta a discreción del portero\". Los clientes deben cumplir con las políticas y el código de vestimenta del lugar. Los boletos cubiertos vencen en 2 horas después del momento de la compra.”"
          }
        }
      }
    },
